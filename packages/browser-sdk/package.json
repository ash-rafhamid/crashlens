{
  "name": "@ash_rafhamid/crashlens-browser-sdk",
  "version": "0.1.0",
  "description": "Browser error reporting SDK for CrashLens",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["error-monitoring", "observability", "typescript", "sdk"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ash-rafhamid/crashlens.git",
    "directory": "packages/browser-sdk"
  },
  "homepage": "https://github.com/ash-rafhamid/crashlens#readme",
  "bugs": {
    "url": "https://github.com/ash-rafhamid/crashlens/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
